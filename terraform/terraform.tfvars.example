# Copie este arquivo para terraform.tfvars e preencha com os seus dados.
# Nao commite o terraform.tfvars (ja esta no .gitignore).

tenancy_ocid = "ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
region       = "sa-saopaulo-1"

# Nomes com sufixo para evitar conflito com tentativas anteriores na tenancy.
compartment_name   = "tdc-ai-agents-lab-tdcsp2026"
dynamic_group_name = "tdc-ai-agents-vm-tdcsp2026"
policy_name        = "tdc-ai-agents-lab-policy-tdcsp2026"

# Opcional: cole sua chave publica SSH aqui se quiser acessar a VM.
# ssh_public_key = "ssh-ed25519 AAAA..."
